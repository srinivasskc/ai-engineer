# OpenRouter API Key (Valid) from https://openrouter.ai/workspaces/default/keys
OPENROUTER_API_KEY= <agent-vault:openrouter-api-key>
    
# Github Personal Access Token (Valid) from https://github.com/marketplace/models/azure-openai/gpt-4o-mini    
OPENAI_API_KEY = <agent-vault:openai-api-key>
    
# Anthropic API Key (Dummy)
ANTHROPIC_API_KEY = <agent-vault:anthropic-api-key>
    
# Gemini API Key (Valid) from https://aistudio.google.com/api-keys
GOOGLE_API_KEY = <agent-vault:google-api-key>
    
# GOREST API Key
GOREST_API_KEY = <agent-vault:gorest-api-key>
    
# HuggingFace Access Token (READ Permissions)
HUGGINGFACEHUB_API_TOKEN=<agent-vault:huggingfacehub-api-token>